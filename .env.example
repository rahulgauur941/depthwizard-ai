# ========================================================
# DepthWizard AI - Production Environment Configuration
# ========================================================

# --- Backend Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Permitted CORS origins (comma-separated, or * for open public access)
CORS_ORIGINS=*

# AI Model Configuration
# Models will attempt to download from Hugging Face or load from MODEL_CHECKPOINT_DIR
MODEL_CHECKPOINT_DIR=backend/models
DEFAULT_DEVICE=cpu

# --- Frontend Configuration ---
# In unified single-container deployment (FastAPI serving SPA), leave VITE_API_URL empty or relative
# If frontend is hosted on a separate CDN/subdomain, specify full backend URL:
# VITE_API_URL=https://your-backend-domain.com
VITE_API_URL=
